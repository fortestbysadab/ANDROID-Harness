<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dangerous permission defined by Termux. The owner must grant it by
         hand under App info > Permissions > Additional permissions; it does
         not appear in the normal runtime prompt list on every device. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Targeting SDK 30+ hides other packages unless they are declared.
         Without this the intent fails silently, which is the single most
         common way this integration appears broken. -->
    <!-- Talking to the model provider. Without this every request
         fails as a transport error that looks like a bad network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Install-time, so there is no prompt: the owner grants it by
         installing the app. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Batch 3b. Each of these is asked for at the moment a tool first
         needs it, never at launch: a prompt with no question attached to
         it is one the owner has no basis to answer. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <queries>
        <package android:name="com.termux" />
    </queries>

    <!-- Needed to read the files Termux copies into shared storage. The
         two alternatives do not work here: a folder picked through the
         document picker yields a content URI that cannot be mapped to the
         POSIX path Termux writes to, and returning bytes through stdout is
         bounded by Binder's transaction limit. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".HarnessApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight">

        <activity
            android:name=".ui.DiagnosticsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A window with no interface. Android will only show a
             permission dialog to an activity, and a tool has none. -->
        <activity
            android:name=".permissions.PermissionRequestActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Notification access is granted in Settings, not by a prompt.
             The system binds this only after the owner turns it on. -->
        <service
            android:name=".notifications.HarnessNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Termux fires this with the command result. Not exported: only
             the PendingIntent we created can trigger it. -->
        <receiver
            android:name=".termux.TermuxResultReceiver"
            android:exported="false" />
    </application>
</manifest>
